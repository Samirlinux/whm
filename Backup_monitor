#!/usr/bin/env bash
# =============================================================================
#  cPanel Backup Monitor
#  Author  : Eng. Samir Abu El-Khair 
#  Version : 1.0
#
#  What it does (daily, via cron):
#    1) Checks that the internal cPanel/WHM backup was taken (fresh + complete)
#    2) Checks that the Git backup was taken AND pushed to the external remote
#    3) Sends a report to Email + Telegram + Slack
#
#  Usage:
#    ./backup-monitor.sh                 # uses backup-monitor.conf next to script
#    ./backup-monitor.sh -c /path/conf   # custom config file
#    ./backup-monitor.sh --test          # only send a test notification
# =============================================================================

set -u
export LC_ALL=C.UTF-8 2>/dev/null || export LC_ALL=C

VERSION="1.0"
AUTHOR="Eng. Samir Abu El-Khair"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONF_FILE="${SCRIPT_DIR}/backup-monitor.conf"
TEST_ONLY="no"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--config) CONF_FILE="$2"; shift 2 ;;
    --test)      TEST_ONLY="yes"; shift ;;
    -v|--version) echo "cPanel Backup Monitor v${VERSION} - ${AUTHOR}"; exit 0 ;;
    -h|--help)   sed -n '2,16p' "$0"; exit 0 ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

# ------------------------------- Defaults ------------------------------------
SERVER_NAME="$(hostname -f 2>/dev/null || hostname)"
LOG_FILE="/var/log/cpanel-backup-monitor.log"
NOTIFY_ON="always"               # always | failure

CHECK_CPANEL="yes"
CPANEL_BACKUP_DIR="/backup"
CPANEL_MAX_AGE_HOURS=26
CPANEL_MIN_ACCOUNTS_PERCENT=95
DISK_WARN_PERCENT=90

CHECK_GIT="yes"
GIT_REPO_DIR=""
GIT_REMOTE="origin"
GIT_BRANCH="main"
GIT_CHECK_COMMIT_AGE="yes"       # set "no" if the repo only commits when files change
GIT_MAX_AGE_HOURS=26

EMAIL_ENABLED="no";    EMAIL_TO="";  EMAIL_FROM="backup-monitor@$(hostname -f 2>/dev/null || hostname)"
TELEGRAM_ENABLED="no"; TELEGRAM_BOT_TOKEN=""; TELEGRAM_CHAT_ID=""
SLACK_ENABLED="no";    SLACK_WEBHOOK_URL=""; SLACK_BOT_TOKEN=""; SLACK_CHANNEL_ID=""

if [[ -f "$CONF_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONF_FILE"
else
  echo "Config file not found: $CONF_FILE  (copy backup-monitor.conf.example first)" >&2
  exit 1
fi

# ------------------------------- Helpers -------------------------------------
log() { echo "[$(date '+%F %T')] $*" >> "$LOG_FILE" 2>/dev/null; }

ar() {
  case "$1" in OK) echo "سليم";; WARN) echo "تحذير";; FAIL) echo "فشل";; *) echo "تم التخطي";; esac
}

icon() {
  case "$1" in OK) echo "✅";; WARN) echo "⚠️";; *) echo "❌";; esac
}

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' \
    | awk '{printf "%s\\n", $0}'
}

# Prevent overlapping runs
exec 9>/tmp/cpanel-backup-monitor.lock
flock -n 9 || { log "Another instance is running. Exit."; exit 0; }

# ------------------------------ Notifications --------------------------------
send_email() {
  [[ "$EMAIL_ENABLED" == "yes" && -n "$EMAIL_TO" ]] || return 0
  local sm; sm="$(command -v sendmail || echo /usr/sbin/sendmail)"
  if [[ ! -x "$sm" ]]; then log "Email: sendmail not found"; return 1; fi
  {
    echo "From: ${EMAIL_FROM}"
    echo "To: ${EMAIL_TO}"
    echo "Subject: ${SUBJECT}"
    echo "MIME-Version: 1.0"
    echo "Content-Type: text/plain; charset=UTF-8"
    echo
    printf '%s\n' "$REPORT"
  } | "$sm" -t -oi && log "Email: sent to ${EMAIL_TO}" || log "Email: FAILED"
}

send_telegram() {
  [[ "$TELEGRAM_ENABLED" == "yes" && -n "$TELEGRAM_BOT_TOKEN" && -n "$TELEGRAM_CHAT_ID" ]] || return 0
  local resp
  resp=$(curl -sS -m 30 -X POST \
    "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    -d chat_id="$TELEGRAM_CHAT_ID" \
    --data-urlencode text="$SUBJECT
$REPORT" 2>&1)
  if echo "$resp" | grep -q '"ok":true'; then log "Telegram: sent"; else log "Telegram: FAILED - $resp"; fi
}

send_slack() {
  [[ "$SLACK_ENABLED" == "yes" ]] || return 0
  local payload resp text
  text="$(json_escape "$SUBJECT
$REPORT")"

  if [[ -n "$SLACK_BOT_TOKEN" && -n "$SLACK_CHANNEL_ID" ]]; then
    # Method A: Bot token + channel ID (chat.postMessage)
    payload="{\"channel\":\"${SLACK_CHANNEL_ID}\",\"text\":\"${text}\"}"
    resp=$(curl -sS -m 30 -X POST https://slack.com/api/chat.postMessage \
      -H "Authorization: Bearer ${SLACK_BOT_TOKEN}" \
      -H 'Content-Type: application/json; charset=utf-8' \
      --data "$payload" 2>&1)
    if echo "$resp" | grep -q '"ok":true'; then log "Slack: sent (bot)"; else log "Slack: FAILED - $resp"; fi
  elif [[ -n "$SLACK_WEBHOOK_URL" ]]; then
    # Method B: Incoming webhook
    payload="{\"text\":\"${text}\"}"
    resp=$(curl -sS -m 30 -X POST -H 'Content-Type: application/json' \
      --data "$payload" "$SLACK_WEBHOOK_URL" 2>&1)
    if [[ "$resp" == "ok" ]]; then log "Slack: sent (webhook)"; else log "Slack: FAILED - $resp"; fi
  else
    log "Slack: enabled but no webhook or bot token configured"
  fi
}

notify_all() {
  send_email
  send_telegram
  send_slack
}

if [[ "$TEST_ONLY" == "yes" ]]; then
  SUBJECT="[تجربة] مراقب النسخ الاحتياطي - ${SERVER_NAME}"
  REPORT="هذه رسالة تجربة من مراقب النسخ الاحتياطي v${VERSION} - م. سمير أبو الخير ✅"
  notify_all
  echo "Test notification sent. Check ${LOG_FILE} for details."
  exit 0
fi

# ------------------------- Check 1: cPanel internal backup -------------------
CP_STATUS="SKIP"; CP_DETAILS=""

check_cpanel() {
  CP_STATUS="OK"; CP_DETAILS=""
  local d=""

  if [[ ! -d "$CPANEL_BACKUP_DIR" ]]; then
    CP_STATUS="FAIL"
    CP_DETAILS="مجلد الباك اب غير موجود: ${CPANEL_BACKUP_DIR} (الهارد غير متصل أو الباك اب متوقف؟)"
    return
  fi

  # Latest dated folder (YYYY-MM-DD) or legacy cpbackup/daily
  local name latest
  name=$(ls -1 "$CPANEL_BACKUP_DIR" 2>/dev/null | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' | sort | tail -n1)
  if [[ -n "$name" ]]; then
    latest="${CPANEL_BACKUP_DIR}/${name}"
  elif [[ -d "${CPANEL_BACKUP_DIR}/cpbackup/daily" ]]; then
    latest="${CPANEL_BACKUP_DIR}/cpbackup/daily"
  else
    CP_STATUS="FAIL"
    CP_DETAILS="لا توجد نسخ احتياطية داخل ${CPANEL_BACKUP_DIR}"
    return
  fi

  local acc_dir="$latest"
  [[ -d "${latest}/accounts" ]] && acc_dir="${latest}/accounts"

  # Freshness
  local newest now age_h backed total pct
  newest=$(find "$acc_dir" -mindepth 1 -maxdepth 1 -printf '%T@\n' 2>/dev/null | sort -n | tail -n1 | cut -d. -f1)
  now=$(date +%s)
  if [[ -z "$newest" ]]; then
    CP_STATUS="FAIL"
    CP_DETAILS="آخر مجلد نسخ احتياطي فارغ: ${latest}"
    return
  fi
  age_h=$(( (now - newest) / 3600 ))

  # Completeness
  backed=$(find "$acc_dir" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
  total=$(ls -1 /var/cpanel/users 2>/dev/null | grep -Ev '^(root|nobody|system|cpanel)$' | wc -l)
  pct=100
  [[ "$total" -gt 0 ]] && pct=$(( backed * 100 / total ))

  d+="المجلد : ${latest}"$'\n'
  d+="آخر ملف : منذ ${age_h} ساعة"$'\n'
  d+="الحسابات : ${backed} تم أخذ نسخة منها من أصل ${total} (${pct}%)"$'\n'

  if (( age_h > CPANEL_MAX_AGE_HOURS )); then
    CP_STATUS="FAIL"
    d+="المشكلة : النسخة أقدم من ${CPANEL_MAX_AGE_HOURS} ساعة"$'\n'
  fi
  if (( pct < CPANEL_MIN_ACCOUNTS_PERCENT )); then
    CP_STATUS="FAIL"
    d+="المشكلة : نسبة الحسابات ${pct}% فقط (الحد الأدنى ${CPANEL_MIN_ACCOUNTS_PERCENT}%)"$'\n'
  fi

  # Backup still running?
  if pgrep -f 'cpanel/bin/backup' >/dev/null 2>&1; then
    d+="ملاحظة : عملية النسخ الاحتياطي تعمل حاليا"$'\n'
    [[ "$CP_STATUS" == "FAIL" ]] && CP_STATUS="WARN"
  fi

  # Disk usage of backup partition
  local used
  used=$(df -P "$CPANEL_BACKUP_DIR" 2>/dev/null | awk 'NR==2{gsub("%","",$5);print $5}')
  if [[ -n "$used" ]]; then
    d+="مساحة الهارد : ${used}% مستخدمة"$'\n'
    if (( used >= DISK_WARN_PERCENT )); then
      d+="تحذير : هارد الباك اب قارب على الامتلاء"$'\n'
      [[ "$CP_STATUS" == "OK" ]] && CP_STATUS="WARN"
    fi
  fi

  CP_DETAILS="$d"
}

# ------------------------- Check 2: Git backup (external copy) ---------------
GIT_STATUS="SKIP"; GIT_DETAILS=""

check_git() {
  GIT_STATUS="OK"; GIT_DETAILS=""
  local d="" g

  if [[ -z "$GIT_REPO_DIR" || ! -d "${GIT_REPO_DIR}/.git" ]]; then
    GIT_STATUS="FAIL"
    GIT_DETAILS="ريبو Git غير موجود: '${GIT_REPO_DIR}'"
    return
  fi

  g() { git -c safe.directory="$GIT_REPO_DIR" -C "$GIT_REPO_DIR" "$@"; }

  local local_hash remote_hash commit_ts age_h dirty
  local_hash=$(g rev-parse "refs/heads/${GIT_BRANCH}" 2>/dev/null)
  if [[ -z "$local_hash" ]]; then
    GIT_STATUS="FAIL"
    GIT_DETAILS="الفرع '${GIT_BRANCH}' غير موجود في ${GIT_REPO_DIR}"
    return
  fi

  # Last local commit age
  commit_ts=$(g log -1 --format=%ct "$GIT_BRANCH" 2>/dev/null)
  age_h=$(( ( $(date +%s) - ${commit_ts:-0} ) / 3600 ))
  d+="آخر commit محلي : ${local_hash:0:8} (منذ ${age_h} ساعة)"$'\n'

  if [[ "$GIT_CHECK_COMMIT_AGE" == "yes" ]] && (( age_h > GIT_MAX_AGE_HOURS )); then
    GIT_STATUS="FAIL"
    d+="المشكلة : آخر commit أقدم من ${GIT_MAX_AGE_HOURS} ساعة (النسخة لم تؤخذ؟)"$'\n'
  fi

  # Uncommitted changes
  dirty=$(g status --porcelain 2>/dev/null | wc -l)
  if (( dirty > 0 )); then
    d+="تحذير : يوجد ${dirty} تغيير غير مسجل (uncommitted) في الريبو"$'\n'
    [[ "$GIT_STATUS" == "OK" ]] && GIT_STATUS="WARN"
  fi

  # External copy: does the remote have our latest commit?
  remote_hash=$(GIT_TERMINAL_PROMPT=0 timeout 60 git -c safe.directory="$GIT_REPO_DIR" \
                -C "$GIT_REPO_DIR" ls-remote "$GIT_REMOTE" "refs/heads/${GIT_BRANCH}" 2>/dev/null | awk '{print $1}')
  if [[ -z "$remote_hash" ]]; then
    GIT_STATUS="FAIL"
    d+="النسخة الخارجية : تعذر الوصول إلى '${GIT_REMOTE}' أو الفرع غير موجود (لم يتم التأكد من النسخة الخارجية)"$'\n'
  elif [[ "$remote_hash" == "$local_hash" ]]; then
    d+="النسخة الخارجية : ${GIT_REMOTE}/${GIT_BRANCH} = ${remote_hash:0:8} (متطابقة مع المحلي ✔)"$'\n'
  else
    GIT_STATUS="FAIL"
    d+="النسخة الخارجية : ${GIT_REMOTE}/${GIT_BRANCH} = ${remote_hash:0:8} (غير متطابقة - فشل الـ push؟)"$'\n'
  fi

  GIT_DETAILS="$d"
}

# ------------------------------ Run ------------------------------------------
log "===== Run started (v${VERSION}) on ${SERVER_NAME} ====="

[[ "$CHECK_CPANEL" == "yes" ]] && check_cpanel
[[ "$CHECK_GIT"    == "yes" ]] && check_git

OVERALL="OK"
for s in "$CP_STATUS" "$GIT_STATUS"; do
  [[ "$s" == "WARN" && "$OVERALL" == "OK" ]] && OVERALL="WARN"
done
for s in "$CP_STATUS" "$GIT_STATUS"; do
  [[ "$s" == "FAIL" ]] && OVERALL="FAIL"
done

SUBJECT="[$(ar "$OVERALL")] تقرير النسخ الاحتياطي - ${SERVER_NAME}"
REPORT="$(icon "$OVERALL") تقرير النسخ الاحتياطي - ${SERVER_NAME}
التاريخ : $(date '+%F %T %Z')
الحالة العامة : $(ar "$OVERALL")
"

if [[ "$CHECK_CPANEL" == "yes" ]]; then
  REPORT+="
$(icon "$CP_STATUS") النسخ الاحتياطي الداخلي للسي بانل : $(ar "$CP_STATUS")
${CP_DETAILS}"
fi
if [[ "$CHECK_GIT" == "yes" ]]; then
  REPORT+="
$(icon "$GIT_STATUS") النسخ الاحتياطي على Git (نسخة خارجية) : $(ar "$GIT_STATUS")
${GIT_DETAILS}"
fi
REPORT+="
-- مراقب النسخ الاحتياطي لـ cPanel v${VERSION} | م. سمير أبو الخير"

log "Result: cPanel=${CP_STATUS} Git=${GIT_STATUS} Overall=${OVERALL}"

if [[ "$NOTIFY_ON" == "always" || "$OVERALL" != "OK" ]]; then
  notify_all
else
  log "Everything OK and NOTIFY_ON=failure -> no notification sent"
fi

log "===== Run finished ====="
printf '%s\n' "$REPORT"

case "$OVERALL" in OK) exit 0;; WARN) exit 1;; *) exit 2;; esac
