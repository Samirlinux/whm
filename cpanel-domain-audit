
#!/usr/bin/env bash
# ============================================================
# Project     : cPanel Domain Audit
# Version     : 3.0
# Developer   : Sameer Abu Elkhair
# Description : Automated cPanel/WHM Domain Audit
# Features    : Domain Expiry, Nameservers, DNS, HTTP/HTTPS,
#               SSL Verification, PHP Version, CSV Reports
# ============================================================

set -Eeuo pipefail
umask 077
export LC_ALL=C

VERSION="3.0"
BASE_DIR="/root/cpanel-domain-audit"
REPORT_DIR="$BASE_DIR/reports"
LOG="$BASE_DIR/audit.log"

mkdir -p "$REPORT_DIR"
chmod 700 "$BASE_DIR" "$REPORT_DIR"

log() {
    echo "[$(date '+%F %T')] $*" | tee -a "$LOG"
}

die() {
    log "ERROR: $*"
    exit 1
}

# ------------------------------------------------------------
# ROOT CHECK
# ------------------------------------------------------------

[[ $EUID -eq 0 ]] || die "Run this script as root."

# ------------------------------------------------------------
# INSTALL DEPENDENCIES AUTOMATICALLY
# ------------------------------------------------------------

install_pkg() {
    local pkg="$1"

    if command -v dnf >/dev/null 2>&1; then
        dnf install -y "$pkg" >>"$LOG" 2>&1
    elif command -v yum >/dev/null 2>&1; then
        yum install -y "$pkg" >>"$LOG" 2>&1
    elif command -v apt-get >/dev/null 2>&1; then
        apt-get install -y "$pkg" >>"$LOG" 2>&1
    else
        return 1
    fi
}

# Determine missing tools and install their packages.
for item in "dig:bind-utils" "curl:curl" "whois:whois" \
            "timeout:coreutils" "python3:python3"; do
    cmd="${item%%:*}"
    pkg="${item#*:}"

    if ! command -v "$cmd" >/dev/null 2>&1; then
        log "Installing dependency: $pkg"
        install_pkg "$pkg" || log "WARNING: Could not install $pkg"
    fi
done

for cmd in dig curl timeout awk sort paste date python3; do
    command -v "$cmd" >/dev/null 2>&1 ||
        die "Required command unavailable: $cmd"
done

[[ -r /etc/userdomains ]] ||
    die "Not a cPanel server: /etc/userdomains not found."

# ------------------------------------------------------------
# CSV HELPER
# ------------------------------------------------------------

csv() {
    local value="${1//$'\r'/}"
    value="${value//\"/\"\"}"
    printf '"%s"' "$value"
}

# ------------------------------------------------------------
# HTTP CHECK
# ------------------------------------------------------------

check_http() {
    local result
    result="$(curl -sS -L \
        --connect-timeout 5 \
        --max-time 15 \
        --max-redirs 5 \
        -o /dev/null \
        -w '%{http_code}' \
        "$1" 2>/dev/null)" || true

    [[ "$result" =~ ^[0-9]{3}$ ]] &&
        printf '%s' "$result" || printf '000'
}

# ------------------------------------------------------------
# DOMAIN INVENTORY
# ------------------------------------------------------------

STAMP="$(date +%F-%H%M%S)"
INVENTORY="$(mktemp)"
trap 'rm -f "$INVENTORY"' EXIT

CSV_REPORT="$REPORT_DIR/domain-audit-$STAMP.csv"
SUMMARY="$REPORT_DIR/domain-audit-$STAMP.txt"

awk -F': *' '
    NF >= 2 {
        d=tolower($1)
        u=$2

        if (d ~ /^[a-z0-9.-]+\.[a-z0-9.-]+$/ &&
            d !~ /^\./ && d !~ /\.\./ &&
            u ~ /^[a-zA-Z0-9_-]+$/) {
            print d "\t" u
        }
    }
' /etc/userdomains | sort -u > "$INVENTORY"

TOTAL="$(wc -l < "$INVENTORY" | tr -d ' ')"
[[ "$TOTAL" -gt 0 ]] || die "No domains found."

printf '%s\n' \
'"Domain","cPanel User","Expiration Date","Days Remaining","Nameservers","Public DNS IPv4","cPanel Server IP","HTTP Status","HTTPS Status","SSL Status","PHP Version","Website Status"' \
> "$CSV_REPORT"

# ------------------------------------------------------------
# MAIN AUDIT
# ------------------------------------------------------------

COUNT=0
RESPONDING=0
UNREACHABLE=0
PHP_UNKNOWN=0
EXPIRY_UNKNOWN=0

while IFS=$'\t' read -r domain user; do
    [[ -n "${domain:-}" ]] || continue
    COUNT=$((COUNT + 1))

    log "[$COUNT/$TOTAL] Checking $domain"

    # Public nameservers
    NS="$(dig +time=3 +tries=1 +short NS "$domain" 2>/dev/null |
        sed 's/\.$//' | sort -u | paste -sd ';' -)"
    [[ -n "$NS" ]] || NS="Not found"

    # Public IPv4 records
    DNS_IP="$(dig +time=3 +tries=1 +short A "$domain" 2>/dev/null |
        grep -E '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' |
        sort -u | paste -sd ';' -)"
    [[ -n "$DNS_IP" ]] || DNS_IP="No A record"

    # cPanel configuration
    USERDATA="/var/cpanel/userdata/$user"
    SERVER_IP="Unknown"
    PHP="Unknown"

    for f in "$USERDATA/$domain" "$USERDATA/${domain}_SSL"; do
        [[ -r "$f" ]] || continue

        if [[ "$SERVER_IP" == "Unknown" ]]; then
            value="$(awk '$1=="IP:" {print $2; exit}' "$f" 2>/dev/null || true)"
            [[ -n "$value" ]] && SERVER_IP="$value"
        fi

        if [[ "$PHP" == "Unknown" ]]; then
            value="$(awk '$1=="phpversion:" {print $2; exit}' "$f" 2>/dev/null || true)"
            [[ -n "$value" ]] && PHP="$value"
        fi
    done

    # MultiPHP API fallback
    if [[ "$PHP" == "Unknown" ]] &&
       command -v whmapi1 >/dev/null 2>&1; then
        value="$(
            whmapi1 --output=json php_get_vhost_versions 2>/dev/null |
            python3 -c '
import json,sys
domain=sys.argv[1].lower()
try:
    data=json.load(sys.stdin)
    for item in data.get("data",{}).get("versions",[]):
        if str(item.get("vhost","")).lower()==domain:
            print(item.get("version",""))
            break
except Exception:
    pass
' "$domain" 2>/dev/null || true
        )"
        [[ -n "$value" ]] && PHP="$value"
    fi

    [[ "$PHP" != "Unknown" ]] || PHP_UNKNOWN=$((PHP_UNKNOWN + 1))

    # HTTP and HTTPS status
    HTTP="$(check_http "http://$domain")"
    HTTPS="$(check_http "https://$domain")"

    # Verify HTTPS certificate without bypassing validation
    if [[ "$HTTPS" == "000" ]]; then
        SSL="HTTPS unavailable"
    elif curl -sS -L --connect-timeout 5 --max-time 15 \
        --max-redirs 5 -o /dev/null "https://$domain" 2>/dev/null; then
        SSL="Valid"
    else
        SSL="Invalid or connection error"
    fi

    # WHOIS expiry date
    EXPIRY="Unavailable"
    DAYS="Unknown"

    if command -v whois >/dev/null 2>&1; then
        WHOIS_DATA="$(timeout 12 whois "$domain" 2>/dev/null || true)"

        RAW_EXPIRY="$(printf '%s\n' "$WHOIS_DATA" | awk '
            BEGIN { IGNORECASE=1 }
            /^[[:space:]]*(Registry Expiry Date|Registrar Registration Expiration Date|Registry Expiration Date|Expiration Date|Expiry Date|Expires On|Expires|paid-till|Domain Expiration Date|Domain expires|expire):/ {
                sub(/^[^:]*:[[:space:]]*/, "")
                if ($0 != "") { print; exit }
            }
        ')"

        if [[ -n "$RAW_EXPIRY" ]]; then
            normalized="$(date -d "$RAW_EXPIRY" +%F 2>/dev/null || true)"

            if [[ -n "$normalized" ]]; then
                EXPIRY="$normalized"
                END_TS="$(date -d "$normalized 00:00:00" +%s)"
                NOW_TS="$(date +%s)"
                DAYS=$(( (END_TS - NOW_TS) / 86400 ))
            fi
        fi
    fi

    [[ "$EXPIRY" != "Unavailable" ]] ||
        EXPIRY_UNKNOWN=$((EXPIRY_UNKNOWN + 1))

    # Website status
    if [[ "$HTTP" == "000" && "$HTTPS" == "000" ]]; then
        WEBSITE="Unreachable"
        UNREACHABLE=$((UNREACHABLE + 1))
    elif [[ "$HTTP" =~ ^5[0-9][0-9]$ ||
            "$HTTPS" =~ ^5[0-9][0-9]$ ]]; then
        WEBSITE="Server Error"
    elif [[ "$HTTP" =~ ^4[0-9][0-9]$ ||
            "$HTTPS" =~ ^4[0-9][0-9]$ ]]; then
        WEBSITE="HTTP Client Error"
        RESPONDING=$((RESPONDING + 1))
    elif [[ "$HTTP" =~ ^[23][0-9][0-9]$ ||
            "$HTTPS" =~ ^[23][0-9][0-9]$ ]]; then
        WEBSITE="Responding"
        RESPONDING=$((RESPONDING + 1))
    else
        WEBSITE="Check Required"
    fi

    # Save CSV row
    {
        csv "$domain";      printf ','
        csv "$user";        printf ','
        csv "$EXPIRY";      printf ','
        csv "$DAYS";        printf ','
        csv "$NS";          printf ','
        csv "$DNS_IP";      printf ','
        csv "$SERVER_IP";   printf ','
        csv "$HTTP";        printf ','
        csv "$HTTPS";       printf ','
        csv "$SSL";         printf ','
        csv "$PHP";         printf ','
        csv "$WEBSITE";     printf '\n'
    } >> "$CSV_REPORT"

done < "$INVENTORY"

# ------------------------------------------------------------
# SUMMARY REPORT
# ------------------------------------------------------------

{
    echo "cPanel Domain Audit v$VERSION"
    echo "Developed by Engineer Sameer Abu Elkhair"
    echo "Generated: $(date '+%F %T %Z')"
    echo "Domains checked: $COUNT"
    echo "Responding: $RESPONDING"
    echo "Unreachable: $UNREACHABLE"
    echo "PHP version unknown: $PHP_UNKNOWN"
    echo "Expiry unavailable: $EXPIRY_UNKNOWN"
    echo "CSV report: $CSV_REPORT"
    echo "Log file: $LOG"
} > "$SUMMARY"

log "============================================================"
log "cPanel Domain Audit v$VERSION completed."
log "Developed by Engineer Sameer Abu Elkhair"
log "Domains checked: $COUNT"
log "CSV report: $CSV_REPORT"
log "Summary report: $SUMMARY"
log "============================================================"

# Retain only the latest 30 CSV reports.
find "$REPORT_DIR" -maxdepth 1 -type f \
    -name 'domain-audit-*.csv' -printf '%T@ %p\n' |
    sort -nr |
    awk 'NR > 30 {print $2}' |
    while IFS= read -r old; do
        rm -f -- "$old"
    done

exit 0
