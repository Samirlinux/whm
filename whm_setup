 stty -echo
 read ans
 stty echo
 if [ ! "$ans" = "GlobalIws.comGIT" ] ; then
 exit
 else
 clear
 echo ""
 echo "========================================="
 echo "GlobalIWS Network 2027 $(cat /etc/redhat-release)"
 echo "========================================="
 echo ""
 echo "kernel : `uname -r`"
 echo "hostname  : `hostname`"
 echo "Server IP : `hostname -i`"
