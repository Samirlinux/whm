# ---------------------------------------------------------------------------
# 14) Install Backup_monitor (Backup_monitor folder of this repo) + daily cron
#     Uses the local copy when this script runs from a git clone of the repo,
#     otherwise downloads the folder's files via the GitHub API.
#     Secrets (SMTP password, Telegram token, Slack webhook) must live ONLY in
#     the local /opt/Backup_monitor/backup-monitor.conf, never in the repo.
# ---------------------------------------------------------------------------
echo
echo "== [14/16] Installing Backup_monitor =="

BM_DIR=/opt/Backup_monitor
mkdir -p "$BM_DIR"

BM_RAW="https://raw.githubusercontent.com/Samirlinux/whm/main/Backup_monitor"
if [ -f "$SELF_DIR/Backup_monitor" ]; then
    echo "Using local single-file copy $SELF_DIR/Backup_monitor -> $BM_DIR/backup-monitor.sh"
    cp -f "$SELF_DIR/Backup_monitor" "$BM_DIR/backup-monitor.sh"
elif [ -d "$SELF_DIR/Backup_monitor" ]; then
    echo "Using local folder copy from $SELF_DIR/Backup_monitor (local backup-monitor.conf is never overwritten)"
    for f in "$SELF_DIR/Backup_monitor"/*; do
        [ -e "$f" ] || continue
        [ "$(basename "$f")" = "backup-monitor.conf" ] && continue
        cp -a "$f" "$BM_DIR/"
    done
else
    echo "No local copy next to this script, downloading $BM_RAW ..."
    if curl -fsSL "$BM_RAW" -o "$BM_DIR/backup-monitor.sh.new" && [ -s "$BM_DIR/backup-monitor.sh.new" ]; then
        mv -f "$BM_DIR/backup-monitor.sh.new" "$BM_DIR/backup-monitor.sh"
    else
        rm -f "$BM_DIR/backup-monitor.sh.new"
        echo "[ERROR] Could not download $BM_RAW (no network?)." >&2
    fi
fi
find "$BM_DIR" -maxdepth 1 -name '*.sh' -exec chmod 755 {} \;
echo "Files in $BM_DIR:"
ls -l "$BM_DIR"

# The JetBackup check inside backup-monitor.sh parses JSON with python3
if ! command -v python3 >/dev/null 2>&1; then
    echo "--- python3 missing, installing (needed by backup-monitor.sh) ---"
    yum install -y python3 2>&1 | tail -n 3
fi

# Local override file (the script sources backup-monitor.conf automatically)
BM_CONF="$BM_DIR/backup-monitor.conf"
if [ ! -f "$BM_CONF" ]; then
    cat > "$BM_CONF" <<'CONF_EOF'
# Local settings for backup-monitor.sh - NOT stored in git. Keep chmod 600.
# Uncomment and fill in on this server:
#SMTP_PASS=""
#TELEGRAM_BOT_TOKEN=""
#SLACK_WEBHOOK_URL=""
#CHECK_GIT="no"
#CPANEL_BACKUP_DIR="/backup"
CONF_EOF
    chmod 600 "$BM_CONF"
    echo "Created $BM_CONF (empty template, chmod 600) - fill in your secrets there."
fi

# Daily cron (08:00 SERVER time) - runs the check and sends the report.
# Uses backup-monitor.sh, or the first .sh file in the folder if it is named differently.
BM_SCRIPT="$BM_DIR/backup-monitor.sh"
if [ ! -f "$BM_SCRIPT" ]; then
    BM_SCRIPT=$(find "$BM_DIR" -maxdepth 1 -name '*.sh' | head -n1)
fi
if [ -n "$BM_SCRIPT" ] && [ -f "$BM_SCRIPT" ]; then
    chmod 755 "$BM_SCRIPT"
    echo "0 8 * * * root $BM_SCRIPT >> /var/log/backup-monitor-cron.log 2>&1" > /etc/cron.d/backup-monitor
    chmod 644 /etc/cron.d/backup-monitor
    echo "Cron installed (/etc/cron.d/backup-monitor):"
    cat /etc/cron.d/backup-monitor
    echo "Server time now: $(date '+%F %T %Z') - the report is sent daily at 08:00 server time."
    echo "Reports are only delivered after the secrets are filled in $BM_CONF."
    echo "Test notifications once with: $BM_SCRIPT --test"
else
    echo "[WARN] No monitor script (*.sh) found in $BM_DIR - cron NOT installed."
fi

