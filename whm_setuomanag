    # JetBackup docs: restart lfd after the repo install on CSF servers so the
    # csf.pignore changes take effect.
    if command -v csf >/dev/null 2>&1; then
        systemctl restart lfd 2>/dev/null || service lfd restart 2>/dev/null
        echo "lfd restarted (csf.pignore reloaded)."
    fi

    if command -v jetapps >/dev/null 2>&1; then
        echo "--- Installing JetBackup 5 (stable tier) ---"
        jetapps --install jetbackup5-cpanel stable
    else
        echo "[ERROR] jetapps not found - JetApps repo install failed, see output above." >&2
    fi
fi

if [ -x /usr/bin/jetbackup5 ]; then
    echo "JetBackup 5 installed. Check/validate license with: /usr/bin/jetbackup5 --license"
fi
echo "NOTE: JetBackup needs a valid license for this server IP before it will run"
