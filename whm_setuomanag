# ---------------------------------------------------------------------------
# 16) Manual update command: installs `whm-update` (NO cron, NOTHING automatic).
#     You run it yourself when you want to pull the latest whm_setup from GitHub.
# ---------------------------------------------------------------------------
echo
echo "== [16/16] Installing the manual 'whm-update' command =="

if git -C "$SELF_DIR" rev-parse --short HEAD >/dev/null 2>&1; then
    rm -f /etc/cron.d/whm-autoupdate /usr/local/sbin/whm-autoupdate   # remove old auto-update if present
    cat > /usr/local/sbin/whm-update <<WU_EOF
#!/bin/bash
# whm-update: pull the latest whm_setup from GitHub, then run it.
#   whm-update          pull + run
#   whm-update --pull   pull only (do not run)
cd "$SELF_DIR" || exit 1
git fetch origin main || exit 1
echo "Current: \$(git rev-parse --short HEAD)  Latest: \$(git rev-parse --short origin/main)"
git reset --hard origin/main || exit 1
bash -n whm_setup || { echo "whm_setup has a syntax error - NOT run"; exit 1; }
[ "\$1" = "--pull" ] && { echo "Pulled only."; exit 0; }
exec bash whm_setup
WU_EOF
    chmod 755 /usr/local/sbin/whm-update
    echo "Installed: run 'whm-update' on a server to pull + run the latest version."
else
    echo "[WARN] $SELF_DIR is not a git checkout - whm-update NOT installed."
fi

echo
echo "=================================================================="
echo " Finished $(date)"
echo " Full log saved at: $LOG"
echo "=================================================================="
