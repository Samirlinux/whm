# ---------------------------------------------------------------------------
# 8b) Apache Include Editor -> Post VirtualHost Include -> All Versions
#     (WHM >> Service Configuration >> Apache Configuration >> Include Editor)
#     This is the file /etc/apache2/conf.d/includes/post_virtualhost_global.conf
#     The block between the BEGIN/END markers is owned by this script, so it
#     is replaced (not duplicated) on every re-run; anything else already in
#     the file is left untouched.
# ---------------------------------------------------------------------------
echo
echo "== [8b/16] Apache Include Editor: Post VirtualHost Include (All Versions) =="

INC_DIR=/etc/apache2/conf.d/includes
INC_FILE="$INC_DIR/post_virtualhost_global.conf"
HTTPD_BIN="$(command -v httpd || echo /usr/sbin/httpd)"
mkdir -p "$INC_DIR"
touch "$INC_FILE"
INC_BAK="${INC_FILE}.bak_$(date +%Y%m%d%H%M%S)"
cp -a "$INC_FILE" "$INC_BAK"

sed -i '/# BEGIN whm_setup security/,/# END whm_setup security/d' "$INC_FILE"
cat >> "$INC_FILE" <<'APACHE_EOF'
# BEGIN whm_setup security
<LocationMatch "^/cgi-sys/defaultwebpage\.cgi$">
    Require all denied
    ErrorDocument 403 "Access not allowed "
</LocationMatch>
# END whm_setup security
APACHE_EOF

# Regenerate httpd.conf so the include is wired in, then validate before restarting
/usr/local/cpanel/scripts/rebuildhttpdconf 2>&1 | tail -n 5

if ! grep -q "post_virtualhost_global.conf" /etc/apache2/conf/httpd.conf 2>/dev/null; then
    echo "[WARN] httpd.conf does not reference post_virtualhost_global.conf yet."
    echo "[WARN] Fallback: WHM >> Apache Configuration >> Include Editor >>"
    echo "[WARN] Post VirtualHost Include >> All Versions, paste the block and Save."
fi

if "$HTTPD_BIN" -t >/dev/null 2>&1; then
    /usr/local/cpanel/scripts/restartsrv_httpd 2>/dev/null
    echo "Apache config OK - defaultwebpage.cgi block added to $INC_FILE, Apache restarted."
else
    echo "[ERROR] Apache config test FAILED with the new include - restoring previous file." >&2
    "$HTTPD_BIN" -t 2>&1 | tail -n 5
    cp -a "$INC_BAK" "$INC_FILE"
    /usr/local/cpanel/scripts/rebuildhttpdconf >/dev/null 2>&1
fi

# ---------------------------------------------------------------------------
# 8c) Additional hardening
#     a) CSF SMTP_BLOCK      - only Exim/root may open outgoing SMTP connections
#     b) Mail limits         - max 100 emails/hour per domain + track origin
#     c) Pure-FTPd           - require TLS, no anonymous logins
#     d) WHM Tweak Settings  - referrer checks, cookie IP validation, no proxy subdomains
#     e) sysctl              - SYN cookies, rp_filter, no ICMP redirects
#     (PHP open_basedir is intentionally NOT done here: the WHM "PHP open_basedir
#      Tweak" no longer exists in EasyApache 4 and a blanket value would break sites.)
# ---------------------------------------------------------------------------
echo
echo "== [8c/16] Additional hardening (SMTP block, mail limits, FTP TLS, Tweak Settings, sysctl) =="

# Helper: set a WHM Tweak Setting and report whether WHM accepted it
set_tweak() {
    local key="$1" value="$2" out
    out=$(whmapi1 set_tweaksetting key="$key" value="$value" 2>&1)
    if echo "$out" | grep -qE '^[[:space:]]+result: 1'; then
        echo "  Tweak Setting ${key} = ${value} : OK"
    else
        echo "  [WARN] Could not set Tweak Setting ${key}=${value} (key name may differ on this cPanel version):"
        echo "$out" | grep -iE 'reason|statusmsg' | head -n 2
    fi
}

# --- a) CSF SMTP_BLOCK ------------------------------------------------------
echo "--- a) CSF SMTP_BLOCK ---"
echo "[WARN] After this, ONLY root, Exim and mail/mailman can open outgoing SMTP"
echo "[WARN] connections (ports 25/465/587). Customer scripts/plugins that send"
echo "[WARN] through an EXTERNAL SMTP server (Gmail, SendGrid, ...) will be rejected"
echo "[WARN] and must use the server's own mail (localhost) instead."
if [ -f /etc/csf/csf.conf ]; then
    if grep -qE '^SMTP_BLOCK[[:space:]]*=' /etc/csf/csf.conf; then
        sed -i -E 's/^SMTP_BLOCK[[:space:]]*=.*/SMTP_BLOCK = "1"/' /etc/csf/csf.conf
    else
        echo 'SMTP_BLOCK = "1"' >> /etc/csf/csf.conf
    fi
    csf -r >/dev/null 2>&1
    grep -E '^SMTP_BLOCK' /etc/csf/csf.conf
    echo "NOTE: WHM >> Security Center >> SMTP Restrictions is NOT enabled on purpose -"
    echo "      with CSF installed, cPanel recommends SMTP_BLOCK instead of both."
else
    echo "[WARN] CSF is not installed - SMTP_BLOCK skipped."
fi

# --- b) Mail limits ---------------------------------------------------------
echo "--- b) Mail limits (WHM Tweak Settings >> Mail) ---"
set_tweak maxemailsperhour 100
set_tweak trackmailuserorigin 1
echo "NOTE: limit is 100 emails/hour per domain - newsletters/mailing lists above that"
echo "      will be blocked/deferred. Per-account overrides: WHM >> Packages / Modify Account."

# --- c) Pure-FTPd: require TLS, no anonymous ---------------------------------
echo "--- c) Pure-FTPd hardening ---"
FTP_SERVER=$(grep -E '^ftpserver=' /var/cpanel/cpanel.config 2>/dev/null | cut -d= -f2)
if [ "$FTP_SERVER" = "pure-ftpd" ]; then
    mkdir -p /var/cpanel/conf/pureftpd
    FTP_LOCAL=/var/cpanel/conf/pureftpd/local
    touch "$FTP_LOCAL"
    cp -a "$FTP_LOCAL" "${FTP_LOCAL}.bak_$(date +%Y%m%d%H%M%S)"
    for kv in "TLS 2" "NoAnonymous yes"; do
        key="${kv%% *}"
        sed -i "/^${key}[[:space:]]/d" "$FTP_LOCAL"
        echo "$kv" >> "$FTP_LOCAL"
    done
    /scripts/setupftpserver pure-ftpd --force 2>&1 | tail -n 5
    echo "Resulting FTP settings (check TLS=2 and NoAnonymous=yes):"
    grep -hE '^(TLS|NoAnonymous)' /etc/pure-ftpd.conf /etc/pureftpd.conf 2>/dev/null
    echo "NOTE: TLS 2 refuses plain (non-TLS) FTP, so old FTP clients without TLS can no"
    echo "      longer connect. SFTP (SSH) is not affected."
else
    echo "FTP server is '${FTP_SERVER:-unknown}' (not pure-ftpd) - FTP hardening skipped."
fi

# --- d) WHM Tweak Settings --------------------------------------------------
echo "--- d) WHM Tweak Settings (Security) ---"
set_tweak referrersafety 1
set_tweak referrerblanksafety 1
set_tweak cookieipvalidation strict
set_tweak proxysubdomains 0
echo "NOTE: proxysubdomains=0 turns off cpanel./webmail./whm.<domain> addresses -"
echo "      users must use <domain>:2083 / :2096 or the server hostname instead."
echo "NOTE: blank-referrer safety can break bookmarks/direct links into cPanel/WHM"
echo "      pages - users must log in through the normal login page first."

# --- e) sysctl network hardening --------------------------------------------
echo "--- e) sysctl network hardening ---"
cat > /etc/sysctl.d/99-whm-hardening.conf <<'SYSCTL_EOF'
# Written by whm_setup
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
SYSCTL_EOF
sysctl --system >/dev/null 2>&1
sysctl net.ipv4.tcp_syncookies net.ipv4.conf.all.rp_filter net.ipv4.conf.all.accept_redirects net.ipv4.conf.all.send_redirects 2>/dev/null
echo "NOTE: strict rp_filter can drop traffic on servers with asymmetric routing /"
echo "      several uplinks - fine on a normal single-uplink server."

# --- f) Shell Fork Bomb Protection (WHM >> Security Center) -------------------
echo "--- f) Shell Fork Bomb Protection ---"
FORKBOMB_BIN=/usr/local/cpanel/bin/install-login-profile
if [ -x "$FORKBOMB_BIN" ]; then
