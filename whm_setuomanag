    if [[ "$CUR_MAXMEM" =~ ^[0-9]+$ ]] && [ "$CUR_MAXMEM" -ne 0 ] && [ "$CUR_MAXMEM" -lt 2048 ]; then
        echo "maxmem is ${CUR_MAXMEM}MB (< 2048), raising to 2048MB for JetBackup."
